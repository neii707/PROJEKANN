-- =========================================
-- ENUM ROLE
-- =========================================

CREATE TYPE tipe_role AS ENUM (
'ADMIN',
'DISTRIBUTOR',
'NELAYAN'
);

-- =========================================
-- USER
-- =========================================

CREATE TABLE usser (
id_user SERIAL PRIMARY KEY,
nama VARCHAR(100) NOT NULL,
no_hp VARCHAR(20) NOT NULL,
username VARCHAR(50) UNIQUE NOT NULL,
passwd VARCHAR(50) NOT NULL,
status_konfir_akun VARCHAR(20) NOT NULL,
role_pilihan tipe_role NOT NULL
);

-- =========================================
-- DEMAND
-- ADMIN MEMBUAT DEMAND
-- =========================================

CREATE TABLE demand (
id_demand SERIAL PRIMARY KEY,
target_kg NUMERIC(10,2) NOT NULL,
deadline DATE NOT NULL,

id_user INT NOT NULL,

FOREIGN KEY (id_user)
REFERENCES usser(id_user)
ON UPDATE CASCADE
ON DELETE RESTRICT
);

-- =========================================
-- PANEN
-- NELAYAN INPUT PANEN
-- =========================================

CREATE TABLE panen (
id_panen SERIAL PRIMARY KEY,
berat_per_kg NUMERIC(10,2) NOT NULL,
tanggal DATE NOT NULL,
id_user INT NOT NULL,

FOREIGN KEY (id_user)
REFERENCES usser(id_user)
ON UPDATE CASCADE
ON DELETE RESTRICT
);

-- =========================================
-- GRADE
-- DISTRIBUTOR MENILAI PANEN
-- GRADE TERHUBUNG KE DEMAND
-- =========================================

CREATE TABLE grade (
id_grade SERIAL PRIMARY KEY,
kategori VARCHAR(10) NOT NULL,
keterangan VARCHAR(100),

harga_per_kg NUMERIC(10,2) NOT NULL,

id_panen INT NOT NULL,
id_demand INT NOT NULL,
id_distributor INT NOT NULL,

FOREIGN KEY (id_panen)
REFERENCES panen(id_panen)
ON UPDATE CASCADE
ON DELETE CASCADE,

FOREIGN KEY (id_demand)
REFERENCES demand(id_demand)
ON UPDATE CASCADE
ON DELETE CASCADE,

FOREIGN KEY (id_distributor)
REFERENCES usser(id_user)
ON UPDATE CASCADE
ON DELETE RESTRICT
);

-- =========================================
-- TRANSAKSI
-- SEKALIGUS MENJADI PENAWARAN
-- =========================================

CREATE TABLE transaksi (
id_transaksi SERIAL PRIMARY KEY,
tanggal DATE NOT NULL,
harga_tawar NUMERIC(10,2) NOT NULL,
total_pembayaran NUMERIC(12,2),
status_transaksi VARCHAR(50)
DEFAULT 'Menunggu',
konfir_penawaran VARCHAR(50)
DEFAULT 'Menunggu',
konfir_pembelian VARCHAR(50)
DEFAULT 'Menunggu',
id_grade INT NOT NULL,
FOREIGN KEY (id_grade)
REFERENCES grade(id_grade)
ON UPDATE CASCADE
ON DELETE CASCADE
);

