CREATE OR REPLACE VIEW view_demand_distributor
 AS
 SELECT COALESCE(sum(target_kg), 0::numeric) AS total_demand
   FROM demand
  WHERE date_trunc('month'::text, deadline::timestamp with time zone) = date_trunc('month'::text, CURRENT_DATE::timestamp with time zone);

CREATE OR REPLACE FUNCTION kurangi_target_demand()

RETURNS TRIGGER

LANGUAGE plpgsql

AS
$$
DECLARE
    beratPanen NUMERIC;

BEGIN

    SELECT p.berat_per_kg
    INTO beratPanen
    FROM grade g
    JOIN panen p
    ON g.id_panen = p.id_panen
    WHERE g.id_grade = NEW.id_grade;

    UPDATE demand

    SET target_kg =
    CASE
        WHEN target_kg - beratPanen < 0
        THEN 0
        ELSE target_kg - beratPanen
    END

    WHERE DATE_TRUNC('month', deadline)
          =
          DATE_TRUNC('month', CURRENT_DATE);

    RETURN NEW;

END;
$$;

CREATE OR REPLACE TRIGGER trigger_kurangi_demand

AFTER UPDATE
ON transaksi

FOR EACH ROW

WHEN
(
    NEW.status_transaksi = 'Selesai'
    AND OLD.status_transaksi <> 'Selesai'
)

EXECUTE FUNCTION kurangi_target_demand();

UPDATE demand
SET target_kg = 0
WHERE DATE_TRUNC('month', deadline)
      =
      DATE_TRUNC('month', CURRENT_DATE);

