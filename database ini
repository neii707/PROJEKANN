CREATE OR REPLACE VIEW public.vw_dashboard_nelayan AS
SELECT
    p.id_panen,
    COALESCE(g.kategori, '-') AS grade,
    p.berat_per_kg            AS berat_kg,
    p.tanggal,
    CASE
        WHEN g.id_grade IS NULL THEN 'Belum Digrading'
        WHEN t.id_transaksi IS NULL THEN 'Sudah Digrading'
        WHEN t.konfir_penawaran = 'Menunggu Ditawar' THEN 'Sedang Ditawar'
        WHEN t.konfir_penawaran = 'Diterima'
             AND COALESCE(t.konfir_pembelian, '') <> 'Selesai' THEN 'Menunggu Konfirmasi Pembayaran'
        ELSE 'Proses'
    END AS status,
    u.username
FROM panen p
LEFT JOIN grade g     ON g.id_panen   = p.id_panen
LEFT JOIN transaksi t ON t.id_grade   = g.id_grade AND t.status_transaksi <> 'Selesai'
LEFT JOIN usser u     ON p.id_user    = u.id_user
WHERE NOT EXISTS (
    SELECT 1
    FROM grade g2
    JOIN transaksi t2 ON t2.id_grade = g2.id_grade
    WHERE g2.id_panen = p.id_panen AND t2.status_transaksi = 'Selesai'
);

CREATE OR REPLACE FUNCTION public.fn_label_dashboard_nelayan(p_username TEXT)
RETURNS TABLE(stok INTEGER, jual INTEGER, pendapatan NUMERIC)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    SELECT
        (SELECT COUNT(*)::INTEGER
         FROM public.panen p2
         JOIN public.usser u2 ON p2.id_user = u2.id_user
         WHERE u2.username = p_username) AS stok,

        (SELECT COUNT(*)::INTEGER
         FROM public.panen p3
         JOIN public.grade g3     ON g3.id_panen   = p3.id_panen
         JOIN public.transaksi t3 ON t3.id_grade   = g3.id_grade
         JOIN public.usser u3     ON p3.id_user    = u3.id_user
         WHERE u3.username = p_username AND t3.status_transaksi = 'Selesai') AS jual,

        COALESCE(SUM(
            CASE
                WHEN LOWER(vt.status::TEXT) = 'selesai' THEN vt.total
                ELSE 0::NUMERIC
            END
        ), 0::NUMERIC) AS pendapatan

    FROM public.usser u
    LEFT JOIN public.panen p            ON u.id_user   = p.id_user
    LEFT JOIN public.vw_riwayat_transaksi vt ON p.id_panen = vt.id_panen
    WHERE u.username = p_username
    GROUP BY u.username;
END;
$$;

CREATE OR REPLACE VIEW public.v_kelola_panen AS
SELECT
    id,
    username,
    berat,
    grade,
    harga_per_kg,
    status,
    CASE WHEN status = 'Belum Di-grade' THEN TRUE ELSE FALSE END AS bisa_hapus,
    id_user
FROM (
    SELECT
        p.id_panen AS id,
        u.username,
        p.id_user,
        p.berat_per_kg AS berat,
        COALESCE(g.kategori, '-')   AS grade,
        COALESCE(g.harga_per_kg, 0) AS harga_per_kg,
        CASE
            WHEN EXISTS (SELECT 1 FROM transaksi t WHERE t.id_grade = g.id_grade)
                THEN (SELECT t.status_transaksi FROM transaksi t WHERE t.id_grade = g.id_grade LIMIT 1)
            WHEN g.id_grade IS NOT NULL THEN 'Sudah Di-grade'
            ELSE 'Belum Di-grade'
        END AS status
    FROM panen p
    JOIN usser u ON p.id_user = u.id_user
    LEFT JOIN grade g ON p.id_panen = g.id_panen
) subquery_panen
ORDER BY
    CASE status
        WHEN 'Belum Di-grade'    THEN 1
        WHEN 'Menunggu Ditawar'  THEN 2
        WHEN 'Sudah Di-grade'    THEN 3
        ELSE 4
    END;

CREATE OR REPLACE FUNCTION public.hapus_panen_aman(p_id_panen INTEGER)
RETURNS TEXT
LANGUAGE plpgsql
AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM grade WHERE id_panen = p_id_panen) THEN
        RETURN 'Gagal: Data panen sudah dinilai/di-grade oleh distributor!';
    ELSE
        DELETE FROM panen WHERE id_panen = p_id_panen;
        RETURN 'Sukses: Data panen berhasil dihapus.';
    END IF;
END;
$$;

CREATE OR REPLACE VIEW public.vw_konfirmasi_penawaran AS
SELECT
    t.id_transaksi,
    p.id_panen,
    u.nama            AS nama_distributor,
    p.berat_per_kg    AS berat_kg,
    g.kategori        AS grade,
    t.harga_tawar,
    p.berat_per_kg * t.harga_tawar AS total,
    t.konfir_penawaran AS status
FROM transaksi t
JOIN grade g ON g.id_grade    = t.id_grade
JOIN panen p ON p.id_panen    = g.id_panen
JOIN usser u ON u.id_user     = g.id_distributor
WHERE t.konfir_penawaran = 'Menunggu';

CREATE OR REPLACE PROCEDURE public.proses_penawaran(
    IN p_id_panen   INTEGER,
    IN p_keputusan  VARCHAR
)
LANGUAGE plpgsql
AS $$
BEGIN
    IF UPPER(p_keputusan) = 'TERIMA' THEN
        UPDATE public.transaksi
        SET
            konfir_penawaran = 'Diterima',
            konfir_pembelian = 'Belum Dibayar',
            status_transaksi = 'Proses'
        WHERE id_grade IN (SELECT id_grade FROM public.grade WHERE id_panen = p_id_panen);

    ELSIF UPPER(p_keputusan) = 'TOLAK' THEN
        UPDATE public.transaksi
        SET
            konfir_penawaran = 'Ditolak',
            status_transaksi = 'Menunggu Ditawar'
        WHERE id_grade IN (SELECT id_grade FROM public.grade WHERE id_panen = p_id_panen);

    ELSE
        RAISE EXCEPTION 'Keputusan tidak valid! Gunakan TERIMA atau TOLAK.';
    END IF;
END;
$$;

CREATE OR REPLACE VIEW public.vw_konfirmasi_transaksi
 AS
 SELECT t.id_transaksi,
    p.id_panen,
    u.nama AS nama_distributor,
    p.berat_per_kg AS berat_kg,
