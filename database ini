    t.harga_tawar,
    t.total_pembayaran,
    t.status_transaksi,
    t.tanggal,
    g.id_distributor
FROM transaksi t
JOIN grade g ON t.id_grade  = g.id_grade
JOIN panen p ON g.id_panen  = p.id_panen
JOIN usser n ON p.id_user   = n.id_user
WHERE t.status_transaksi = 'Selesai';

CREATE OR REPLACE FUNCTION total_pembayaran_distributor(p_id_distributor INT)
RETURNS NUMERIC
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN (
        SELECT COALESCE(SUM(t.total_pembayaran), 0)
        FROM transaksi t
        JOIN grade g ON t.id_grade = g.id_grade
        WHERE t.status_transaksi = 'Selesai'
          AND g.id_distributor = p_id_distributor
    );
END;
$$;

CREATE OR REPLACE FUNCTION total_selesai_distributor(p_id_distributor INT)
RETURNS INT
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN (
        SELECT COUNT(*)
        FROM transaksi t
        JOIN grade g ON t.id_grade = g.id_grade
        WHERE t.status_transaksi = 'Selesai'
          AND g.id_distributor = p_id_distributor
    );
END;
$$;
