CREATE OR REPLACE VIEW v_aktivitas_terkini AS
SELECT 
    'NEL0' || p.id_panen AS id, 
    u.nama AS pengguna, 
    'Input Panen (' || p.berat_per_kg || ' Kg)' AS aktivitas
FROM panen p
JOIN usser u ON p.id_user = u.id_user

UNION ALL

SELECT 
    'DIS0' || d.id_demand AS id, 
    u.nama AS pengguna, 
    'Minta Demand (' || d.target_kg || ' Kg)' AS aktivitas
FROM demand d
JOIN usser u ON d.id_user = u.id_user;

CREATE OR REPLACE VIEW public.v_demand
 AS
 SELECT 'DEM0'::text || id_demand AS id,
    target_kg,
    deadline AS tanggal
   FROM demand d;

CREATE OR REPLACE VIEW public.v_grafik_line_stok
 AS
 SELECT to_char(t.tanggal::timestamp with time zone, 'Month'::text) AS bulan,
    EXTRACT(month FROM t.tanggal) AS urutan_bulan,
    g.kategori AS grade,
    sum(p.berat_per_kg) AS stok
   FROM transaksi t
     JOIN grade g ON t.id_grade = g.id_grade
     JOIN panen p ON p.id_panen = g.id_panen
  WHERE t.status_transaksi::text = 'Selesai'::text
  GROUP BY (to_char(t.tanggal::timestamp with time zone, 'Month'::text)), (EXTRACT(month FROM t.tanggal)), g.kategori
  ORDER BY (EXTRACT(month FROM t.tanggal)), g.kategori;

CREATE OR REPLACE VIEW public.v_grafik_line_transaksi
 AS
 SELECT to_char(t.tanggal::timestamp with time zone, 'Month'::text) AS bulan,
    EXTRACT(month FROM t.tanggal) AS urutan_bulan,
    g.kategori AS grade,
    count(t.id_transaksi) AS total_transaksi
   FROM transaksi t
     JOIN grade g ON t.id_grade = g.id_grade
  WHERE t.status_transaksi::text = 'Selesai'::text
  GROUP BY (to_char(t.tanggal::timestamp with time zone, 'Month'::text)), (EXTRACT(month FROM t.tanggal)), g.kategori
  ORDER BY (EXTRACT(month FROM t.tanggal)), g.kategori;

