-- =========================================
-- TRIGGER: CEK PERUBAHAN TRANSAKSI SELESAI
-- (dibuat setelah INSERT data agar data seed tidak terblokir)
-- =========================================

CREATE OR REPLACE FUNCTION public.log_perubahan_transaksi()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    IF OLD.status_transaksi = 'Selesai' THEN
        RAISE EXCEPTION 'Transaksi dengan ID % sudah berstatus Selesai dan tidak dapat diubah kembali!', OLD.id_transaksi;
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_cek_perubahan_transaksi
BEFORE UPDATE ON public.transaksi
FOR EACH ROW
EXECUTE FUNCTION public.log_perubahan_transaksi();

