CREATE OR REPLACE FUNCTION jumlah_panen()
RETURNS INT
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN (
        SELECT COUNT(*)
        FROM panen p
        WHERE NOT EXISTS (
            SELECT 1 FROM grade g WHERE g.id_panen = p.id_panen
        )
    );
END;
$$;

CREATE OR REPLACE FUNCTION total_demand_distributor()
RETURNS NUMERIC
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN (
        SELECT COALESCE(SUM(target_kg), 0)
        FROM demand
        WHERE DATE_TRUNC('month', deadline) = DATE_TRUNC('month', CURRENT_DATE)
    );
END;
$$;

CREATE OR REPLACE FUNCTION kurangi_target_demand()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    beratPanen NUMERIC;
BEGIN
    SELECT p.berat_per_kg
    INTO beratPanen
    FROM grade g
    JOIN panen p ON g.id_panen = p.id_panen
    WHERE g.id_grade = NEW.id_grade;

    UPDATE demand
    SET target_kg = CASE
                        WHEN target_kg - beratPanen < 0 THEN 0
                        ELSE target_kg - beratPanen
                    END
    WHERE DATE_TRUNC('month', deadline) = DATE_TRUNC('month', CURRENT_DATE);

    RETURN NEW;
END;
$$;

-- FIX: pakai CREATE OR REPLACE TRIGGER agar tidak error saat dijalankan ulang
CREATE OR REPLACE TRIGGER trigger_kurangi_demand
AFTER UPDATE ON transaksi
FOR EACH ROW
WHEN (NEW.status_transaksi = 'Selesai' AND OLD.status_transaksi <> 'Selesai')
EXECUTE FUNCTION kurangi_target_demand();

CREATE OR REPLACE FUNCTION total_transaksi_distributor(p_id_distributor INT)
RETURNS INT
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN (
        SELECT COUNT(*)
        FROM transaksi t
        JOIN grade g ON t.id_grade = g.id_grade
        WHERE t.status_transaksi = 'Selesai'
          AND g.id_distributor = p_id_distributor
    );
END;
$$;

