CREATE OR REPLACE VIEW view_penawaran AS
SELECT
    g.id_grade,
    p.id_panen,
    u.nama AS nelayan,
    g.kategori,
    g.harga_per_kg,
    g.keterangan
FROM grade g
JOIN panen p
    ON g.id_panen = p.id_panen
JOIN usser u
    ON p.id_user = u.id_user
LEFT JOIN transaksi t
    ON g.id_grade = t.id_grade
WHERE t.id_transaksi IS NULL
ORDER BY g.id_grade DESC;


CREATE OR REPLACE PROCEDURE tambah_penawaran(
    p_harga NUMERIC,
    p_id_grade INT
)
LANGUAGE plpgsql
AS
$$
BEGIN

    INSERT INTO transaksi
    (
        tanggal,
        harga_tawar,
        status_transaksi,
        konfir_penawaran,
        konfir_pembelian,
        id_grade
    )
    VALUES
    (
        CURRENT_DATE,
        p_harga,
        'Menunggu',
        'Menunggu',
        'Menunggu',
        p_id_grade
    );

END;
$$;


