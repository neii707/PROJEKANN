JOIN panen p ON g.id_panen  = p.id_panen
JOIN usser u ON p.id_user   = u.id_user
WHERE t.status_transaksi = 'Selesai'
ORDER BY t.id_transaksi DESC;

CREATE OR REPLACE VIEW view_lihat_panen AS
SELECT
    p.id_panen,
    u.nama AS nama_nelayan,
    p.berat_per_kg,
    p.tanggal
FROM panen p
JOIN usser u
ON p.id_user = u.id_user
WHERE NOT EXISTS
(
    SELECT 1
    FROM grade g
    WHERE g.id_panen = p.id_panen
)
ORDER BY p.id_panen DESC;

CREATE OR REPLACE VIEW view_grading_panen AS
SELECT
    p.id_panen,
    u.nama AS nelayan,
    p.berat_per_kg,
    p.tanggal
FROM panen p
JOIN usser u ON p.id_user = u.id_user
WHERE NOT EXISTS (
    SELECT 1 FROM grade g WHERE g.id_panen = p.id_panen
)
ORDER BY p.id_panen DESC;

CREATE OR REPLACE PROCEDURE tambah_grading(
    p_kategori      VARCHAR,
    p_keterangan    TEXT,
    p_harga         NUMERIC,
    p_id_panen      INT,
    p_id_demand     INT,
    p_id_distributor INT
)
LANGUAGE plpgsql
AS $$
BEGIN
    IF (
        SELECT p.berat_per_kg FROM panen p WHERE p.id_panen = p_id_panen
    ) > (
        SELECT SUM(d.target_kg) FROM demand d
    ) THEN
        RAISE EXCEPTION 'Berat panen melebihi sisa demand';
    END IF;

    INSERT INTO grade (kategori, keterangan, harga_per_kg, id_panen, id_demand, id_distributor)
    VALUES (p_kategori, p_keterangan, p_harga, p_id_panen, p_id_demand, p_id_distributor);
END;
$$;

CREATE OR REPLACE VIEW public.view_penawaran AS
SELECT
    g.id_grade,
    p.id_panen,
    u.nama      AS nelayan,
    g.kategori,
    g.harga_per_kg,
    g.keterangan,
    g.id_distributor
FROM grade g
JOIN panen p ON g.id_panen   = p.id_panen
JOIN usser u ON p.id_user    = u.id_user
LEFT JOIN transaksi t ON g.id_grade = t.id_grade
WHERE t.id_transaksi IS NULL
ORDER BY g.id_grade DESC;

CREATE OR REPLACE PROCEDURE tambah_penawaran(
    p_harga    NUMERIC,
    p_id_grade INT
)
LANGUAGE plpgsql
AS $$
BEGIN
    INSERT INTO transaksi (tanggal, harga_tawar, status_transaksi, konfir_penawaran, konfir_pembelian, id_grade)
    VALUES (CURRENT_DATE, p_harga, 'Menunggu', 'Menunggu', 'Menunggu', p_id_grade);
END;
$$;

CREATE OR REPLACE VIEW view_transaksi_distributor AS
SELECT
    t.id_transaksi,
    n.nama       AS nelayan,
    g.kategori,
    p.berat_per_kg,
    t.harga_tawar,
    t.total_pembayaran,
    t.status_transaksi,
    g.id_distributor
FROM transaksi t
JOIN grade g ON t.id_grade  = g.id_grade
JOIN panen p ON g.id_panen  = p.id_panen
JOIN usser n ON p.id_user   = n.id_user
WHERE t.konfir_penawaran = 'Diterima'
  AND t.status_transaksi <> 'Selesai';

CREATE OR REPLACE PROCEDURE konfirmasi_pembayaran(p_id_transaksi INT)
LANGUAGE plpgsql
AS $$
BEGIN
    UPDATE transaksi
    SET
        status_transaksi = 'Sudah Dibayar',
        konfir_pembelian = 'Sudah Dibayar'
    WHERE id_transaksi = p_id_transaksi;
END;
$$;

