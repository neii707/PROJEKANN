-- vw_dashboard_nelayan 
CREATE OR REPLACE VIEW public.vw_dashboard_nelayan
 AS
 SELECT p.id_panen,
    COALESCE(g.kategori, '-'::character varying) AS grade,
    p.berat_per_kg AS berat_kg,
    p.tanggal,
        CASE
            WHEN g.id_grade IS NULL THEN 'Belum Digrading'::text
            WHEN t.id_transaksi IS NULL THEN 'Sudah Digrading'::text
            WHEN t.konfir_penawaran::text = 'Menunggu Ditawar'::text THEN 'Sedang Ditawar'::text
            WHEN t.konfir_penawaran::text = 'Diterima'::text AND COALESCE(t.konfir_pembelian, ''::character varying)::text <> 'Selesai'::text THEN 'Menunggu Konfirmasi Pembayaran'::text
            ELSE 'Proses'::text
        END AS status,
    u.username
   FROM panen p
     LEFT JOIN grade g ON g.id_panen = p.id_panen
     LEFT JOIN transaksi t ON t.id_grade = g.id_grade AND t.status_transaksi::text <> 'Selesai'::text
     LEFT JOIN usser u ON p.id_user = u.id_user
  WHERE NOT (EXISTS ( SELECT 1
           FROM grade g2
             JOIN transaksi t2 ON t2.id_grade = g2.id_grade
          WHERE g2.id_panen = p.id_panen AND t2.status_transaksi::text = 'Selesai'::text));

-- fn_label_dashboard_nelayan (function)
CREATE OR REPLACE FUNCTION public.fn_summary_dashboard_nelayan(p_username text)
RETURNS TABLE(stok integer, jual integer, pendapatan numeric) 
LANGUAGE 'plpgsql'
AS $$
BEGIN
    RETURN QUERY
    SELECT 
        public.fn_stok_panen(p_username::character varying) AS stok,
        public.fn_penjualan(p_username::character varying) AS jual,
        COALESCE(SUM(
            CASE
                WHEN LOWER(vt.status::text) = 'selesai'::text THEN vt.total
                ELSE 0::numeric
            END), 0::numeric) AS pendapatan
    FROM public.usser u
    LEFT JOIN public.panen p ON u.id_user = p.id_user
    LEFT JOIN public.vw_riwayat_transaksi vt ON p.id_panen = vt.id_panen
    WHERE u.username = p_username
    GROUP BY u.username;
END;
$$;

CREATE OR REPLACE FUNCTION public.fn_stok_panen(
	p_username character varying)
    RETURNS integer
    LANGUAGE 'sql'
AS $$
    SELECT COUNT(*)::INT
    FROM vw_dashboard_nelayan
    WHERE username = p_username; 
$$;

CREATE OR REPLACE FUNCTION public.fn_penjualan(
	p_username character varying)
    RETURNS integer
    LANGUAGE 'sql'
AS $$
    SELECT COUNT(*)::INT
    FROM panen p
    JOIN grade      g ON g.id_panen = p.id_panen
    JOIN transaksi t ON t.id_grade = g.id_grade
    JOIN usser     u ON p.id_user = u.id_user                     
    WHERE u.username       = p_username                           
      AND t.status_transaksi = 'Selesai';
$$;

--v_kelola_panen 
CREATE OR REPLACE VIEW public.v_kelola_panen
 AS
 SELECT id,
    username,
    berat,
    grade,
    harga_per_kg,
    status,
        CASE
            WHEN status::text = 'Belum Di-grade'::text THEN true
            ELSE false
        END AS bisa_hapus,
    id_user
   FROM ( SELECT p.id_panen AS id,
            u.username,
            p.id_user,
            p.berat_per_kg AS berat,
            COALESCE(g.kategori, '-'::character varying) AS grade,
            COALESCE(g.harga_per_kg, 0::numeric) AS harga_per_kg,
                CASE
                    WHEN (EXISTS ( SELECT 1
                       FROM transaksi t
                      WHERE t.id_grade = g.id_grade)) THEN ( SELECT t.status_transaksi
                       FROM transaksi t
                      WHERE t.id_grade = g.id_grade
                     LIMIT 1)
                    WHEN g.id_grade IS NOT NULL THEN 'Sudah Di-grade'::character varying
                    ELSE 'Belum Di-grade'::character varying
                END AS status
           FROM panen p
             JOIN usser u ON p.id_user = u.id_user
             LEFT JOIN grade g ON p.id_panen = g.id_panen) subquery_panen
  ORDER BY (
        CASE status
            WHEN 'Belum Di-grade'::text THEN 1
            WHEN 'Menunggu Ditawar'::text THEN 2
            WHEN 'Sudah Di-grade'::text THEN 3
            ELSE 4
        END);

--hapus_panen_aman (fn)
CREATE OR REPLACE FUNCTION public.hapus_panen_aman(
	p_id_panen integer)
    RETURNS text
    LANGUAGE 'plpgsql'
AS $$
BEGIN
    IF EXISTS (SELECT 1 FROM grade WHERE id_panen = p_id_panen) THEN
        RETURN 'Gagal: Data panen sudah dinilai/di-grade oleh distributor!';
    ELSE
        DELETE FROM panen WHERE id_panen = p_id_panen;
        RETURN 'Sukses: Data panen berhasil dihapus.';
    END IF;
END;
$$;

--vw_konfirmasi_penawaran
CREATE OR REPLACE VIEW public.vw_konfirmasi_penawaran
 AS
 SELECT t.id_transaksi,
    p.id_panen,
    u.nama AS nama_distributor,
    p.berat_per_kg AS berat_kg,
    g.kategori AS grade,
    t.harga_tawar,
    p.berat_per_kg * t.harga_tawar AS total,
    t.konfir_penawaran AS status
   FROM transaksi t
     JOIN grade g ON g.id_grade = t.id_grade
     JOIN panen p ON p.id_panen = g.id_panen
     JOIN usser u ON u.id_user = g.id_distributor
  WHERE t.konfir_penawaran::text = 'Menunggu'::text;

--vw_konfirmasi_transaksi 
CREATE OR REPLACE VIEW public.vw_konfirmasi_transaksi
 AS
 SELECT t.id_transaksi,
    p.id_panen,
    u.nama AS nama_distributor,
    p.berat_per_kg AS berat_kg,
    p.berat_per_kg * t.harga_tawar AS total_pembayaran,
    t.konfir_pembelian AS status
   FROM transaksi t
     JOIN grade g ON g.id_grade = t.id_grade
     JOIN panen p ON p.id_panen = g.id_panen
     JOIN usser u ON u.id_user = g.id_distributor
  WHERE t.konfir_penawaran::text = 'Diterima'::text AND t.konfir_pembelian::text <> 'Selesai'::text;

--sp_konfirmasi_transaksi_by_panen (procedure)
CREATE OR REPLACE PROCEDURE public.sp_konfirmasi_transaksi_by_panen(
    IN p_id_panen integer,
    IN p_tanggal_konfir date DEFAULT CURRENT_DATE)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
    v_id_transaksi integer;
    v_status_pembelian character varying(50);
BEGIN
    SELECT t.id_transaksi, t.konfir_pembelian 
    INTO v_id_transaksi, v_status_pembelian
    FROM public.transaksi t
    JOIN public.grade g ON g.id_grade = t.id_grade
    WHERE g.id_panen = p_id_panen
    LIMIT 1;

    IF v_id_transaksi IS NULL THEN
        RAISE EXCEPTION 'Transaksi untuk ID Panen % tidak ditemukan.', p_id_panen;
    END IF;

    IF v_status_pembelian IS NULL OR LOWER(v_status_pembelian) = 'belum dibayar' THEN
        RAISE EXCEPTION 'Transaksi tidak bisa dikonfirmasi! Tunggu distributor melakukan pembayaran terlebih dahulu.';
    END IF;

    UPDATE public.transaksi 
    SET status_transaksi = 'Selesai', 
        konfir_pembelian = 'Selesai', 
        tanggal = p_tanggal_konfir     
    WHERE id_transaksi = v_id_transaksi;

END;
$BODY$;

--fn_label_riwayat_nelayan
CREATE OR REPLACE FUNCTION public.fn_label_riwayat_nelayan(p_username text)
RETURNS TABLE(total_transaksi bigint, total_nilai numeric) 
LANGUAGE 'plpgsql'
AS $$
BEGIN
    RETURN QUERY
    SELECT 
        COUNT(id_panen) AS total_transaksi,
        COALESCE(SUM(total), 0::numeric) AS total_nilai
    FROM public.vw_riwayat_transaksi
    WHERE username_nelayan = p_username;
END;
$$;

--vw_riwayat_transaksi
CREATE OR REPLACE VIEW public.vw_riwayat_transaksi
 AS
 SELECT p.id_panen,
    u_dist.nama AS nama_distributor,
    p.berat_per_kg AS berat_kg,
    g.kategori AS grade,
    g.harga_per_kg,
    t.total_pembayaran AS total,
    t.tanggal AS tanggal_konfirmasi,
    t.status_transaksi AS status,
    p.id_user AS id_nelayan,
    u_nel.username AS username_nelayan
   FROM transaksi t
     JOIN grade g ON g.id_grade = t.id_grade
     JOIN panen p ON p.id_panen = g.id_panen
     JOIN usser u_dist ON u_dist.id_user = g.id_distributor
     JOIN usser u_nel ON u_nel.id_user = p.id_user
  WHERE t.status_transaksi::text = 'Selesai'::text;

--trigger transaksi selesai
CREATE OR REPLACE FUNCTION public.log_perubahan_transaksi()
    RETURNS trigger
    LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
    IF OLD.status_transaksi = 'Selesai' THEN
        RAISE EXCEPTION 'Transaksi dengan ID % sudah berstatus Selesai dan tidak dapat diubah kembali!', OLD.id_transaksi;
    END IF;
    
    RETURN NEW;
END;
$BODY$;

CREATE TRIGGER trg_cek_perubahan_transaksi
    BEFORE UPDATE
    ON public.transaksi
    FOR EACH ROW
    EXECUTE FUNCTION public.log_perubahan_transaksi();

