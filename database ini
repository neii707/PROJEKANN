--view jumlah panen di dashboard distributor
CREATE OR REPLACE VIEW view_jumlah_panen AS
SELECT COUNT(*) AS total_panen
FROM panen;

--view demand aktif di dashboard distributor
CREATE OR REPLACE VIEW view_demand_aktif AS
SELECT COUNT(*) AS total_demand
FROM demand
WHERE deadline >= CURRENT_DATE;

--view total transaksi di dashboard distributor
CREATE OR REPLACE VIEW view_total_transaksi AS
SELECT
COALESCE(SUM(total_pembayaran),0) AS total_transaksi
FROM transaksi
WHERE status_transaksi='Selesai';

--view db distri menampilkan dgv bbrp transaksi paling akhir
CREATE OR REPLACE VIEW view_dashboard_distributor AS
SELECT
    n.nama AS nelayan,

    p.berat_per_kg ||
    ' Kg - Grade ' ||
    g.kategori ||
    ' - Rp ' ||
    TO_CHAR(t.total_pembayaran, 'FM999G999G999')

    AS aktivitas,

    t.tanggal

FROM transaksi t

JOIN grade g
ON t.id_grade = g.id_grade

JOIN panen p
ON g.id_panen = p.id_panen

JOIN usser n
ON p.id_user = n.id_user

ORDER BY t.tanggal DESC;

--cek view
SELECT * FROM view_dashboard_distributor;

-- admin view
CREATE OR REPLACE VIEW v_aktivitas_terkini AS
SELECT 
    'NEL0' || p.id_panen AS id, 
    u.nama AS pengguna, 
    'Input Panen (' || p.berat_per_kg || ' Kg)' AS aktivitas
FROM panen p
JOIN usser u ON p.id_user = u.id_user

UNION ALL

SELECT 
    'DIS0' || d.id_demand AS id, 
    u.nama AS pengguna, 
    'Minta Demand (' || d.target_kg || ' Kg)' AS aktivitas
FROM demand d
JOIN usser u ON d.id_user = u.id_user;

